# LayaMCP settings (env-overridable via LAYAMCP_* prefix).
# Copy to `.env` and adjust as needed.

LAYAMCP_HOST=127.0.0.1
LAYAMCP_PORT=8765
LAYAMCP_PRELOAD_MODELS=true
LAYAMCP_LOG_LEVEL=INFO

# Usage / session log for training data (SQLite in ./data by default).
LAYAMCP_USAGE_ENABLED=true
# Store raw input text too? Off by default (inputs may contain secrets).
LAYAMCP_USAGE_STORE_TEXT=false

# Allow the laya_update tool to `pip install -U laya` and re-download models.
LAYAMCP_ALLOW_UPDATES=false
