# DecisionMCP settings (env-overridable via DECISIONMCP_* prefix).
# Copy to `.env` and adjust as needed.

DECISIONMCP_HOST=127.0.0.1
DECISIONMCP_PORT=8765
DECISIONMCP_PRELOAD_MODELS=true
# Decision engine: "laya" (default) or "d1" (LiquidAI d1-3B via transformers,
# installed with the `d1` extra).
DECISIONMCP_ENGINE=laya
DECISIONMCP_LOG_LEVEL=INFO

# Usage / session log for training data (SQLite in ./data by default).
DECISIONMCP_USAGE_ENABLED=true
# Store raw input text too? Off by default (inputs may contain secrets).
DECISIONMCP_USAGE_STORE_TEXT=false

# Allow the decision_update tool to `pip install -U laya` and re-download models.
DECISIONMCP_ALLOW_UPDATES=false

# Browser access: comma-separated origins whose pages may call /mcp from JavaScript
# (e.g. http://localhost:8000). Empty = no CORS headers, so no web page can call the
# server. Wildcards are refused because the server has no auth.
DECISIONMCP_CORS_ORIGINS=
